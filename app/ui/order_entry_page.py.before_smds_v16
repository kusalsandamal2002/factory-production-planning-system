        cancel_button.setObjectName("SecondaryButton")
        buttons.accepted.connect(self.accept)
        buttons.rejected.connect(self.reject)
        root.addWidget(buttons)

    def _add_line_to_list(self, line_name: str) -> None:
        line_name = _safe_text(line_name, "")
        if not line_name:
            return
        existing = {self.lines_list.item(i).text() for i in range(self.lines_list.count())}
        if line_name not in existing:
            self.lines_list.addItem(QListWidgetItem(line_name))

    def add_selected_line(self) -> None:
        self._add_line_to_list(self.line_combo.currentText())

    def remove_selected_lines(self) -> None:
        for item in self.lines_list.selectedItems():
            self.lines_list.takeItem(self.lines_list.row(item))

    def selected_lines(self) -> list[str]:
        return [self.lines_list.item(i).text() for i in range(self.lines_list.count())]

    def data(self) -> dict:
        lines = self.selected_lines()
        day_qty = int(self.day_plan_input.value())
        night_qty = int(self.night_plan_input.value())
        total_qty = int(self.total_plan_input.value()) or day_qty + night_qty
        return {
            "key_code": _safe_text(self.mold_key_input.text()),
            "casing_type": _safe_text(self.casing_type_input.text(), "No Casing"),
            "line": ", ".join(lines) if lines else "-",
            "selected_lines": lines,
            "curing_cycle": _safe_text(self.curing_time_input.text()),
            "normal_curing_minutes": float(self.curing_minutes_input.value()),
            "handling_minutes": float(self.handling_minutes_input.value()),
            "day_plan": day_qty,
            "night_plan": night_qty,
            "total_plan": total_qty,
            "planning_manager_approval_status": "Approved",
        }


