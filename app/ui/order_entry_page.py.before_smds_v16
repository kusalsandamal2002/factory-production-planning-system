APPROVED_VALUES = {"approved", "approval", "approve", "apruwal", "approved by planning manager"}


def _safe_text(value: Any, default: str = "-") -> str:
    text_value = str(value or "").strip()
    if not text_value or text_value.lower() in {"none", "nan", "null"}:
        return default
    return text_value


def _approval_status(value: Any) -> str:
    status = _safe_text(value, "Pending")
    normalized = status.strip().lower()
    if normalized in APPROVED_VALUES:
        return "Approved"
    if normalized.startswith("reject"):
        return "Rejected"
    return "Pending"


def _is_approved(value: Any) -> bool:
    return _approval_status(value) == "Approved"


def _split_lines(value: Any) -> list[str]:
    raw = str(value or "").strip()
    if not raw or raw == "-":
        return []
    parts = [part.strip() for part in re.split(r"[,/;]+", raw) if part.strip()]
    return [] if parts == ["-"] else parts


def _fmt_number_text(value: Any) -> str:
    try:
        number = float(value or 0)
    except Exception:
        return "-"
    if number <= 0:
        return "-"
    if number.is_integer():
        return str(int(number))
    return f"{number:.2f}".rstrip("0").rstrip(".")


def _floor_int(value: Any) -> int:
    try:
        number = float(value or 0)
        if number <= 0:
            return 0
        return int(math.floor(number))
    except Exception:
        return 0


def _q(column_name: str) -> str:
    return '"' + column_name.replace('"', '""') + '"'


