            self.curing_table.setCellWidget(row_index, 5, action_widget)

    def _number_text(self, value) -> str:
        try:
            number = float(value or 0)

            if number <= 0:
                return "-"

            if number.is_integer():
                return str(int(number))

            return str(number).rstrip("0").rstrip(".")
        except Exception:
            return "-"


